# Variables d'environnement du service d'envoi des devis.
# À renseigner dans l'interface de votre hébergeur (Netlify / Vercel),
# jamais dans le dépôt : ce fichier n'est qu'un modèle.

# --- Envoi des e-mails (obligatoire) ---------------------------------
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur — le domaine doit être vérifié dans Resend.
DEVIS_FROM="Rubis Événements <devis@rubis-evenements.fr>"

# Boîte qui reçoit les demandes de devis.
DEVIS_TO=contact@rubis-evenements.fr

# Copie cachée interne (facultatif).
DEVIS_BCC=

# Nom affiché dans les e-mails (facultatif, défaut : Rubis Événements).
SITE_NAME=Rubis Événements

# --- Anti-robot (fortement recommandé) -------------------------------
# Clé secrète Cloudflare Turnstile : https://dash.cloudflare.com/?to=/:account/turnstile
# La clé publique correspondante se renseigne dans assets/js/main.js (TURNSTILE_SITE_KEY).
#
# Sans cette clé, les demandes vous parviennent toujours, mais l'accusé de
# réception au prospect n'est PAS envoyé : un e-mail partant vers une adresse
# quelconque avec un texte libre transformerait le formulaire en relais à spam
# depuis votre domaine. Configurez Turnstile pour activer la réponse automatique.
TURNSTILE_SECRET=
